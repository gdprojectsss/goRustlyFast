pkgname=grfsh-bin
_name=grfsh
pkgver=1.0.0
pkgrel=1
pkgdesc="Small Unix shell with bash style scripting, typed table pipelines and an agent mode"
arch=('x86_64' 'aarch64')
url="https://grf.sh"
license=('MIT')
depends_aarch64=('gcc-libs')
provides=("$_name")
conflicts=("$_name")
install=grfsh.install
source_x86_64=("$_name-$pkgver-x86_64.tar.gz::https://github.com/gdprojectsss/goRustlyFast/releases/download/v$pkgver/$_name-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_name-$pkgver-aarch64.tar.gz::https://github.com/gdprojectsss/goRustlyFast/releases/download/v$pkgver/$_name-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('b3f6856a598a19625f3bdf5a04a7038245fee40f2690fc8501999cf62d18847d')
sha256sums_aarch64=('7f796ffa1849f3f13f47cd4bc3eb83d8b2a41f9f342a1b886632ad28e8ca3f7b')

package() {
    cd "$_name-v$pkgver"-*
    install -Dm755 grfsh "$pkgdir/usr/bin/grfsh"
    install -Dm644 grfsh.1 "$pkgdir/usr/share/man/man1/grfsh.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
